# ---- server ----
PORT=4000
NODE_ENV=development

# Comma-separated list; the Expo dev client and the app scheme both need to be allowed.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- database ----
# Local: mongodb://localhost:27017/marginalia
# Docker compose: mongodb://mongo:27017/marginalia
MONGODB_URI=mongodb://localhost:27017/marginalia

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-please-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-a-different-long-random-string
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=60d

# ---- Google sign-in (optional) ----
# Leave blank to disable the /auth/google route entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- book metadata (optional) ----
# Raises the anonymous rate limit on the Google Books fallback.
GOOGLE_BOOKS_API_KEY=
