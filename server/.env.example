# Local development. On Render, none of this file is used — see
# render.yaml and server/README.md#deploying-to-render.
#
# Only MONGODB_URI and the two JWT secrets need real values.
# Everything else already works as it stands.

# ---- required ----
# Local: mongodb://localhost:27017/marginalia
# Docker compose: mongodb://mongo:27017/marginalia
# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/marginalia?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/marginalia

# Two different long random strings. Generate each with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- has a sensible default, change only if you want to ----
PORT=4000
NODE_ENV=development
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=60d

# Comma-separated. Leave empty for "the mobile app only" — a phone sends no
# Origin header. Only needed if a website ever calls this API.
CORS_ORIGINS=

# ---- optional: Google sign-in ----
# Leave all three blank and Google sign-in simply does not exist.
# Email accounts and guest mode are unaffected.
# In production the callback must be your real URL, not localhost:
#   https://your-service.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- optional: book metadata ----
# Open Library needs no key. This only raises the rate limit on the
# Google Books fallback, which fills in missing summaries and page counts.
GOOGLE_BOOKS_API_KEY=
