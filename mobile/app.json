{
  "expo": {
    "name": "Bookie",
    "slug": "marginalia-book-journal",
    "scheme": "marginalia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EBDC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marginalia.bookjournal",
      "infoPlist": {
        "NSCameraUsageDescription": "Bookie uses the camera to scan book barcodes so you can add books to your shelves in a second.",
        "NSPhotoLibraryUsageDescription": "Bookie lets you attach photos to your journal entries.",
        "NSMicrophoneUsageDescription": "Bookie lets you record little voice notes about what you are reading.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.marginalia.bookjournal",
      "adaptiveIcon": {
        "backgroundColor": "#AD937C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EBDC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1C2229"
          }
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-audio",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Bookie uses the camera to scan book barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookie lets you attach photos to your journal entries."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8C5A3C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8517de98-4737-4890-953e-3f89e2adc71a"
      }
    }
  }
}
