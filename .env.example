# Copy to .env before `docker compose up`.
# Generate each secret with: openssl rand -base64 48

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=60d
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GOOGLE_BOOKS_API_KEY=
