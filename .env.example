# Only used by `docker compose up` for local development.
# Render does not read this file — see render.yaml.
#
# Generate each secret with: openssl rand -base64 48

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- everything below is optional ---
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=60d
CORS_ORIGINS=
GOOGLE_BOOKS_API_KEY=
